# Copia este archivo a .env (nunca se sube al repositorio).
# Clave de DeepSeek para el botón «Evento con IA». Sin ella, se usan eventos del catálogo.
DEEPSEEK_API_KEY=
# Opcional: modelo a usar (por defecto, deepseek-flash).
DEEPSEEK_MODEL=
# Opcional: puerto y host del servidor (por defecto, 3000 y 127.0.0.1).
PORT=3000
HOST=127.0.0.1
